rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function bounded(maximum) {
      return request.query.limit != null && request.query.limit <= maximum;
    }
    match /games/{id} {
      allow get: if resource.data.status == 'active';
      allow list: if resource.data.status == 'active' && bounded(51);
    }
    // Shorts/comments are served only by the API after checking their game.
    match /shorts/{id} { allow read, write: if false; }
    match /comments/{id} { allow read, write: if false; }
    // All client writes and all access to private collections are denied,
    // including requests carrying an administrative claim.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

