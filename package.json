{
  "name": "project-site-shorts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:firestore": "node scripts/dev-firestore.mjs",
    "emulators": "node scripts/firebase-local.mjs start",
    "seed:firestore": "node scripts/seed-firestore.mjs",
    "test:firestore": "node scripts/firebase-local.mjs test",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "security:check": "node scripts/check-repository-security.mjs",
    "security:history": "node scripts/check-repository-security.mjs --history",
    "security:audit": "npm audit --audit-level=moderate --ignore-scripts"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "firebase-tools": "^15.34.1",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "firebase-tools": {
      "@google-cloud/pubsub": {
        "@opentelemetry/core": "2.8.0"
      },
      "gaxios": {
        "uuid": "11.1.1"
      }
    }
  }
}
